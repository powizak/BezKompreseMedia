---
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { organizationSchema, websiteSchema, homePageSchema } from '../data/schema.ts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Page-specific JSON-LD schemas (Service, BreadcrumbList, …). Organization/WebSite are added automatically. */
  schema?: object | object[];
}

const {
  title = 'Multimediální služby | Tvorba webu, fotografie, video | BezKomprese Media',
  description = 'Profesionální multimediální agentura z Klatov. Tvorba webových stránek, svatební a portrétní fotografie, video produkce a správa sociálních sítí.',
  noindex = false,
  schema = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const cookieYesId = import.meta.env.PUBLIC_COOKIEYES_ID;
// Chrome Origin Trial token for WebMCP (optional; trial window Chrome 149–156,
// remove after stable ships). Not a secret — origin-bound, embedded in HTML.
const webmcpTrialToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN;
const isHome = Astro.url.pathname === '/';

// Organization on every page; WebSite + homepage ItemList on the root
const schemas: object[] = [organizationSchema];
if (isHome) schemas.push(websiteSchema, homePageSchema);
schemas.push(...(Array.isArray(schema) ? schema : [schema]));

const allPages = [
  { label: 'Domů', href: '/', footer: false },
  { label: 'Náš tým', href: '/nas-tym/', footer: true },
  { label: 'Foto', href: '/foto/', footer: true },
  { label: 'Video', href: '/video/', footer: true },
  { label: 'Web', href: '/web/', footer: true },
  { label: 'Sociální sítě', href: '/socialni-site/', footer: true },
  { label: 'Galerie', href: '/galerie/', footer: true },
  { label: 'Ceník', href: '/cenik/', footer: true },
];

const navItems = allPages;
const footerServices = allPages.filter((p) => p.footer);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#1a1a18" />

    {/* Chrome Origin Trial: enables WebMCP (document.modelContext) for real visitors during the trial window */}
    {webmcpTrialToken && <meta http-equiv="origin-trial" content={webmcpTrialToken} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="BezKomprese Media — multimediální služby: web, foto, video, sociální sítě"
    />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="BezKomprese Media" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
    <meta
      name="twitter:image:alt"
      content="BezKomprese Media — multimediální služby: web, foto, video, sociální sítě"
    />

    <!-- Structured data (JSON-LD) -->
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon-180.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <!-- CookieYes Consent Banner (deferred so it does not block rendering) -->
    {
      cookieYesId && (
        <script
          id="cookieyes"
          type="text/javascript"
          defer
          src={`https://cdn-cookieyes.com/client_data/${cookieYesId}/script.js`}
        />
      )
    }
  </head>
  <body>
    <SiteHeader navItems={navItems} />

    <main>
      <slot />
    </main>

    <SiteFooter services={footerServices} />

    <script src="../scripts/scroll-animations.js"></script>
    <script src="../scripts/webmcp.ts"></script>
    <script>
      const hamburger = document.querySelector('.hamburger');
      const mobileNav = document.querySelector('.nav-mobile');
      hamburger?.addEventListener('click', () => {
        mobileNav?.classList.toggle('open');
        hamburger.classList.toggle('active');
        const isOpen = mobileNav?.classList.contains('open');
        hamburger.setAttribute('aria-expanded', String(isOpen));
      });
    </script>
  </body>
</html>
